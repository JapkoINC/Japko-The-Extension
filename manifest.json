{
  "manifest_version": 3,
  "name": "Japko The Extension",
  "version": "1.0",
   "description": "Zmienia 'Jabłko' i 'Apple' na Japko",
    "icons": {
    "64": "icons/border-48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "japkoinc@gmail.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}